{
  "name": "beezi-ai",
  "displayName": "Beezi AI",
  "description": "Seamlessly work locally with code, branches, and implementation plans generated by the Beezi platform.",
  "version": "1.0.0",
  "publisher": "beezi",
  "engines": { "vscode": "^1.85.0" },
  "icon": "images/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Beezi-AI/BeeziAI-extension"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onUri"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Beezi AI",
      "properties": {
        "beeziOpen.baseFolder": {
          "type": "string",
          "default": "",
          "description": "Base folder where repositories will be cloned. If empty, user home + /beezi-workspaces is used."
        },
        "beeziOpen.alwaysAskDestination": {
          "type": "boolean",
          "default": false,
          "description": "If true, asks destination folder every time."
        }
      }
    }
  },
 "scripts": {
  "vscode:prepublish": "npm run compile",
  "compile": "tsc -p ./",
  "watch": "tsc -watch -p ./",
  "package": "npx @vscode/vsce package"
},
  "devDependencies": {
  "@types/node": "^20.10.0",
  "@types/vscode": "^1.85.0",
  "typescript": "^5.3.3"
}
}
